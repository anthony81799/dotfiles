{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "tui": "fullscreen",
  "theme": "dark",
  "feedbackDrafts": "off",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl --user:*)",
      "Bash(journalctl:*)",
      "Bash(rpm -q:*)",
      "Bash(dnf list:*)",
      "Bash(ip:*)",
      "Bash(ping:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(python3:*)",
      "Bash(npm run:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(make:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Waiting for input' || true"
          }
        ]
      }
    ]
  }
}
